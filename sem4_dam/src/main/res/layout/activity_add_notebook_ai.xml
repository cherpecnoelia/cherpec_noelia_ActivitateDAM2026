<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adăugare Notiță (Design AI)"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Titlu Notiță"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etTitleAi"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Introduceți titlul aici..."
                    android:inputType="textPersonName"
                    android:background="@android:drawable/editbox_background"
                    android:paddingHorizontal="12dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp" />


                <CheckBox
                    android:id="@+id/cbImportantAi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Marchează ca Important ⭐"
                    android:textSize="15sp"
                    android:textColor="#334155"
                    android:layout_marginBottom="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginBottom="16dp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Categorie"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:textSize="14sp" />

                <RadioGroup
                    android:id="@+id/rgCategoryAi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp">

                    <RadioButton
                        android:id="@+id/rbPersonalAi"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Personal"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbWorkAi"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Muncă" />
                </RadioGroup>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nivel Prioritate (Meniu)"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/spPriorityAi"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginBottom="16dp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Evaluare / Rating"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:textSize="14sp" />

                <RatingBar
                    android:id="@+id/ratingBarAi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="1.0"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp" />


                <Switch
                    android:id="@+id/swArchiveAi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Salvează direct în arhivă"
                    android:textColor="#334155"
                    android:textSize="15sp"
                    android:layout_marginBottom="24dp" />


                <Button
                    android:id="@+id/btnSaveAi"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Salvează Notița"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>